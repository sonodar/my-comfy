[Unit]
Description=ComfyUI
After=mycomfy-init.service network-online.target
Requires=mycomfy-init.service
OnFailure=mycomfy-notify-failure@%n.service

[Service]
Type=simple
WorkingDirectory=/opt/ComfyUI
ExecStart=/opt/pytorch/bin/python /opt/ComfyUI/main.py --listen 0.0.0.0 --port 8188
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
