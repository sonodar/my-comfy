[Unit]
Description=ComfyUI
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/instance-store/ComfyUI
EnvironmentFile=/etc/mycomfy/env
ExecStart=/mnt/instance-store/ComfyUI/venv/bin/python /mnt/instance-store/ComfyUI/main.py --listen 0.0.0.0 --port 8188 --output-directory /mnt/s3files/output
ExecStopPost=-:/bin/sh -c 'if [ "$SERVICE_RESULT" != success ] && [ -n "$NOTIFY_TOPIC_ARN" ] && grep -qx ready /run/mycomfy-boot-status 2>/dev/null; then AWS_DEFAULT_REGION="$AWS_REGION" exec /usr/bin/timeout 10s /usr/local/bin/notify.sh "mycomfy の ComfyUI が異常終了しました。結果 ${SERVICE_RESULT}、ホスト $(hostname)、時刻 $(TZ=Asia/Tokyo date -Iseconds)"; fi'
Restart=on-failure
RestartSec=10
