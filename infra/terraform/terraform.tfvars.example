# コピーして terraform.tfvars として使う。実値はここに書く（git 管理外）。
# notify_topic_arn は notify-me 側の SNS トピック ARN。

aws_region = "ap-northeast-1"
vpc_id     = "vpc-xxxxxxxxxxxxxxxxx"
subnet_id  = "subnet-xxxxxxxxxxxxxxxxx"
# マウントターゲットを作る AZ 分（a/c/d）のサブネット。インスタンスが実際に使うのは subnet_id の1つだけ
subnet_ids = ["subnet-xxxxxxxxxxxxxxxxx", "subnet-yyyyyyyyyyyyyyyyy", "subnet-zzzzzzzzzzzzzzzzz"]

instance_type = "g6e.xlarge"
# dlami_ssm_parameter = "/aws/service/deeplearning/ami/x86_64/oss-nvidia-driver-gpu-pytorch-2.12-ubuntu-24.04/latest/ami-id"
# comfyui_version = "v0.46.0"

notify_topic_arn = "arn:aws:sns:ap-northeast-1:000000000000:notify-me-topic"

# Tailscale の認証キーは tfvars には書かない。apply のときに環境変数で渡すこと：
#   TF_VAR_tailscale_auth_key="tskey-auth-..." terraform apply
# 認証キーは SSM パラメータ /mycomfy/tailscale-auth-key に保存される。
# キーは Reusable かつ Ephemeral で発行すること（Ephemeral のマシンはオフラインで
# tailnet から自動削除される）。ローテーション時は tailscale_auth_key_version を上げて再 apply する。
# 認証キーは新規インスタンスの参加登録に使う。この構成では作り直しのたびに登録が発生するので
# 実質は起動のたびに要る。期限（既定90日）が切れると新しいインスタンスの登録が失敗するため、
# その場合は新しいキーを発行して値だけ差し替える。
# 別途、初回登録後に Tailscale 管理画面でマシン mycomfy の key expiry を無効化しておくこと
# （マシン側の鍵の期限、既定180日が切れるとそのマシンの接続が切れるため）。
tailscale_auth_key_version = 1

# key_name = "my-key"
